{
  "name": "auto-changelog",
  "version": "2.6.1",
  "description": "Command line tool for generating a changelog from git tags and commit history",
  "main": "./src/index.js",
  "bin": {
    "auto-changelog": "./src/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./": "./src/index.js",
    "./package": "./package.json",
    "./package.json": "./package.json",
    "./src": "./src/index.js",
    "./src/": "./src/index.js",
    "./src/commits": "./src/commits.js",
    "./src/commits.js": "./src/commits.js",
    "./src/index": "./src/index.js",
    "./src/index.js": "./src/index.js",
    "./src/releases": "./src/releases.js",
    "./src/releases.js": "./src/releases.js",
    "./src/remote": "./src/remote.js",
    "./src/remote.js": "./src/remote.js",
    "./src/run": "./src/run.js",
    "./src/run.js": "./src/run.js",
    "./src/tags": "./src/tags.js",
    "./src/tags.js": "./src/tags.js",
    "./src/template": "./src/template.js",
    "./src/template.js": "./src/template.js",
    "./src/utils": "./src/utils.js",
    "./src/utils.js": "./src/utils.js"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "prepack": "npmignore --auto --commentLines=autogenerated",
    "prelint": "markdownlint \"**/*.md\" -i node_modules -i LICENSE.md",
    "lint": "standard --verbose | snazzy",
    "lint-fix": "standard --fix",
    "pretest": "npm run lint",
    "test": "npm run tests-only",
    "posttest": "npx npm@\">= 10.2\" audit --production",
    "tests-only": "nyc tape 'test/*.js'",
    "preversion": "npm run lint && npm run test",
    "version": "node src/index.js --package && git add CHANGELOG.md"
  },
  "author": "Pete Cook (https://github.com/cookpete)",
  "homepage": "https://github.com/CookPete/auto-changelog",
  "repository": {
    "type": "git",
    "url": "https://github.com/CookPete/auto-changelog.git"
  },
  "bugs": {
    "url": "https://github.com/CookPete/auto-changelog/issues"
  },
  "keywords": [
    "auto",
    "automatic",
    "changelog",
    "change",
    "log",
    "generator",
    "git",
    "commit",
    "commits",
    "history"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^7.2.0",
    "handlebars": "^4.7.9",
    "import-cwd": "^3.0.0",
    "parse-github-url": "^1.0.4",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.48.0",
    "npmignore": "^0.3.5",
    "nyc": "^15.1.0",
    "snazzy": "^9.0.0",
    "standard": "^16.0.4",
    "tape": "^5.10.2"
  },
  "standard": {
    "ignore": [
      "test/data/"
    ]
  },
  "auto-changelog": {
    "breakingPattern": "Breaking change"
  },
  "publishConfig": {
    "ignore": [
      ".github",
      ".nycrc",
      "coverage",
      "scripts",
      "test",
      ".markdownlintrc",
      "codecov.yml"
    ]
  }
}
